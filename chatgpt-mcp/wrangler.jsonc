{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sourcebraid-mcp",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "PUBLIC_ORIGIN": "https://mcp.sourcebraid.com"
  },
  "kv_namespaces": [
    { "binding": "OAUTH_KV" }
  ],
  "ratelimits": [
    { "name": "AUTH_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
    { "name": "MCP_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } }
  ],
  "routes": [
    { "pattern": "mcp.sourcebraid.com", "custom_domain": true }
  ],
  "observability": {
    "enabled": false
  }
}
